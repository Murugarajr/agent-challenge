# Nosana Configuration
NOSANA_MODEL_ENDPOINT=https://api.nosana.io/v0/chat/completions
NOSANA_API_KEY=your_nosana_api_key_here

# GitHub (optional, for private repos)
GITHUB_TOKEN=your_github_token_here

# Python Analysis Service
MISOKI_GITHUB_API_BASE=https://api.github.com
MISOKI_MAX_REPO_FILES=40
MISOKI_REQUEST_TIMEOUT_SECONDS=30

# ElizaOS Agent
MISOKI_ANALYSIS_SERVICE_URL=http://analysis-service:8000
MISOKI_ANALYSIS_MAX_FILES=10

# Web Frontend
NEXT_PUBLIC_ANALYSIS_SERVICE_URL=http://analysis-service:8000
NEXT_PUBLIC_AGENT_URL=http://agent:3000
