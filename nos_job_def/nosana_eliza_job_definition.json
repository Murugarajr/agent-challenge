{
  "version": "0.1",
  "type": "container",
  "meta": {
    "trigger": "dashboard"
  },
  "ops": [
    {
      "id": "misoki",
      "type": "container/run",
      "args": {
        "image": "misoki/misoki-all:latest",
        "expose": 8080,
        "env": {
          "OPENAI_BASE_URL": "https://YOUR-NOSANA-INFERENCE-HOST/v1",
          "OPENAI_API_KEY": "",
          "OPENAI_SMALL_MODEL": "Qwen/Qwen3.5-4B",
          "OPENAI_LARGE_MODEL": "Qwen/Qwen3.5-4B",
          "GITHUB_TOKEN": "",
          "MISOKI_GITHUB_API_BASE": "https://api.github.com",
          "MISOKI_MAX_REPO_FILES": "40",
          "MISOKI_REQUEST_TIMEOUT_SECONDS": "30",
          "MISOKI_ANALYSIS_MAX_FILES": "10",
          "MISOKI_ANALYSIS_TIMEOUT_MS": "120000"
        }
      }
    }
  ]
}
